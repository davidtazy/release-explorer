# Copy to .env and fill in. .env is git-ignored.

# OAuth application id (public). Create the app in GitLab → Preferences → Applications.
# Redirect URI must be exactly http://localhost:5173/callback and the scope read_api.
# Restart the dev server after changing this value.
VITE_GITLAB_CLIENT_ID=

# Optional: GitLab instance (default https://gitlab.com). Register the OAuth app there.
# VITE_GITLAB_INSTANCE_URL=https://gitlab.example.com

# Seeder only: personal access token with the api scope (the app does not use it).
TOKEN=

# Optional: root group name, or full path under an existing parent group.
# FAKE_GITLAB_ROOT=fake-gitlab
# FAKE_GITLAB_ROOT=your-user/fake-gitlab

# Optional overrides:
# GITLAB_URL=https://gitlab.com
# FAKE_GITLAB_DIR=fake-gitlab
# FAKE_GITLAB_VISIBILITY=private
