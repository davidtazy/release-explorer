# Copy to .env and fill in. .env is git-ignored.

# OAuth application id (public). Create the app in GitLab → Preferences → Applications.
# The redirect URI must match VITE_REDIRECT_URI exactly and the scope is read_api.
# Restart the dev server after changing any VITE_* value.
VITE_GITLAB_CLIENT_ID=your-application-id

# GitLab instance (default https://gitlab.com).
VITE_GITLAB_URL=https://gitlab.com

# Base path the app is served from (default /). Use a subpath ending in / if needed.
# Changing this requires restarting the dev server / rebuilding.
VITE_APP_BASE_URL=/

# Exact OAuth redirect URI. Must match the GitLab application.
# Defaults to <current origin><VITE_APP_BASE_URL>callback.
VITE_REDIRECT_URI=http://localhost:5173/callback


# -------------------------------------------------------------------------------
# Seeder only: personal access token with the api scope (the app does not use it).
TOKEN=

# Optional: root group name, or full path under an existing parent group.
# FAKE_GITLAB_ROOT=fake-gitlab
# FAKE_GITLAB_ROOT=your-user/fake-gitlab

# Optional overrides:
# GITLAB_URL=https://gitlab.com
# FAKE_GITLAB_DIR=fake-gitlab
# FAKE_GITLAB_VISIBILITY=private
